{
  "name": "bie-cms",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/bie-frontend",
    "apps/bie-backend",
    "libs/bie-models"
  ],
  "scripts": {
    "ng": "ng",
    "watch:front": "npm -w apps/bie-frontend run watch",
    "test:front": "npm -w apps/bie-frontend run test",
    "serve:ssr": "npm -w apps/bie-frontend run serve:ssr",
    "start:back": "npm -w apps/bie-backend run start",
    "start:ssr": "node dist/bie-frontend/browser/server/server.mjs",
    "start:csr": "node tools/serve-csr.cjs",
    "dev": "node tools/run-dev.cjs",
    "dev:front": "npm -w apps/bie-frontend run start",
    "dev:back": "npm -w apps/bie-backend run dev",
    "dev:ssr": "npm run dev -- --ssr",
    "prod:ssr": "node tools/run-prod.cjs",
    "build:prod": "node tools/run-build.cjs",
    "build:front": "npm -w apps/bie-frontend run build",
    "build:back": "npm -w apps/bie-backend run build",
    "build": "npm run build:prod",
    "db:bootstrap": "npm -w bie-backend run db:bootstrap",
    "db:migrate": "npm -w bie-backend run migrate",
    "db:seed:admin": "npm -w bie-backend run seed:admin",
    "db:drop": "npm -w bie-backend run drop:db",
    "db:rebase": "npm run db:drop && npm run db:bootstrap && npm run db:migrate && npm run db:seed:admin",
    "db:all": "npm run db:bootstrap && npm run db:migrate && npm run db:seed:admin",
    "lib:build": "npm -w libs/bie-models run build"
  },
  "devDependencies": {
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^18.18.0",
    "baseline-browser-mapping": "^2.9.8",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^21.0.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@angular/animations": "^21.0.6",
    "@angular/cdk": "~21.0.5",
    "@angular/common": "^21.0.6",
    "@angular/compiler": "^21.0.6",
    "@angular/core": "^21.0.6",
    "@angular/forms": "^21.0.6",
    "@angular/material": "~21.0.5",
    "@angular/platform-browser": "^21.0.6",
    "@angular/platform-browser-dynamic": "^21.0.6",
    "@angular/platform-server": "^21.0.6",
    "@angular/router": "^21.0.6",
    "@angular/ssr": "^21.0.4",
    "imagekit": "^6.0.0",
    "ngx-quill": "^30.0.1",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.1.12",
    "zone.js": "~0.15.0"
  }
}
